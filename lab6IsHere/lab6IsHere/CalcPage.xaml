<Page x:Class="lab6IsHere.CalcPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:lab6IsHere"
      mc:Ignorable="d" 
      d:DesignHeight="459.6" d:DesignWidth="591.2"
      Title="CalcPage">

    <Grid Background="#FFFFFF">
        <StackPanel Width="350" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center">Розрахунок трикутника</TextBlock>
            <TextBlock Text="Введіть довжину катета:"/>
            <TextBox Name="txtLeg" Margin="0,5,0,15" Padding="5" FontSize="14"/>
            <TextBlock Text="Введіть прилеглий гострий кут:"/>
            <TextBox Name="txtAngle" Margin="0,5,0,20" Padding="5" FontSize="14"/>

            <Button Content="Обчислити" Padding="10" Background="#808080" Foreground="White" FontSize="16" Click="BtnCalculate_Click" BorderThickness="5"/>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Name="txtResultArea" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                    <TextBlock Name="txtResultPerimeter" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </Border>

            <Button Content="Повернутися на головну" 
                    FontSize="14" 
                    Padding="15,8" 
                    Background="#808080" 
                    Foreground="White" 
                    HorizontalAlignment="Center" 
                    Margin="0,30,0,0" 
                    Click="BtnGoBack_Click"/>
        </StackPanel>
    </Grid>
</Page>